# ========================================================
# Bluff Configuration (.env)
# ========================================================

# Server Port
PORT=3402

# Sui Network Environment ('mainnet' or 'testnet')
SUI_NETWORK=mainnet

# Tatum API Key (Get free key at https://dashboard.tatum.io/)
# Used for Tatum Sui Gateway: https://sui-mainnet.gateway.tatum.io
TATUM_API_KEY=

# Walrus Memory Credentials (Get at https://memory.walrus.xyz/dashboard)
# Required for writing persistent memories on Walrus Mainnet:
MEMWAL_KEY=
MEMWAL_ACCOUNT_ID=
MEMWAL_SERVER_URL=https://relayer.memory.walrus.xyz
MEMWAL_NAMESPACE=bluff-mainnet

# Bluff Arbiter Sui Vault Address (Receives x402 stakes)
ARBITER_SUI_ADDRESS=0x68ca62935f09c2ccc0d8dfb99d1806c3dab9d394922d3d9dcd4a48952ea4427a
